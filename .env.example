# Copy this file to .env.local and fill in your real values.

# Paystack — Dashboard → Settings → API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
# SECRET key: server only. Never share it or put it in NEXT_PUBLIC_ variables.
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Calendly — your main link plus one link per session type (optional)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username
NEXT_PUBLIC_CALENDLY_BROKEN_HEART_URL=https://calendly.com/your-username/broken-heart-session
NEXT_PUBLIC_CALENDLY_CONFLICT_URL=https://calendly.com/your-username/conflict-resolution
NEXT_PUBLIC_CALENDLY_FAITH_URL=https://calendly.com/your-username/faith-conversation
