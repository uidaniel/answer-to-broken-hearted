# Copy this file to .env.local and fill in your real values.

# Paystack — Dashboard → Settings → API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
# SECRET key: server only. Never share it or put it in NEXT_PUBLIC_ variables.
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Calendly: one event type per paid session length (create a 1-hour, 2-hour and 3-hour event)
NEXT_PUBLIC_CALENDLY_1H_URL=https://calendly.com/your-username/1-hour-session
NEXT_PUBLIC_CALENDLY_2H_URL=https://calendly.com/your-username/2-hour-session
NEXT_PUBLIC_CALENDLY_3H_URL=https://calendly.com/your-username/3-hour-session
